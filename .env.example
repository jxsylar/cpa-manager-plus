# 首次执行 ./generate-env.sh 会生成 .env；也可复制本文件后手动填写以下三项。
# provider 和客户端 API Key 在 Web 页面配置，保存在 data/ 下，不放在 .env。

# Manager 管理页面的初始管理员登录密钥；修改变量不会重置已有管理员凭据。
CPA_MANAGER_ADMIN_KEY=
# CLIProxyAPI 管理密钥，同时传给 CLIProxyAPI 的 MANAGEMENT_PASSWORD 和 Manager。
CPA_MANAGEMENT_KEY=
# Manager 数据加密密钥：32 字节随机值的 Base64 编码，已有数据时不要更换。
CPA_MANAGER_DATA_KEY=

# 以下项已有默认值，需要自定义时才取消注释。
# 宿主机数据根目录，相对路径按 Compose 项目目录解析。
# DATA_ROOT=./data
# CLIProxyAPI 和 init 使用的固定版本镜像。
# CLI_PROXY_IMAGE=eceasy/cli-proxy-api:v7.2.156
# CPA Manager Plus 使用的固定版本镜像。
# CPA_MANAGER_IMAGE=seakee/cpa-manager-plus:1.12.10
# CLIProxyAPI 部署模式，默认空值为普通模式；cloud 在缺少配置时等待配置。
# DEPLOY=
